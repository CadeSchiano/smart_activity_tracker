# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters

# Comma-separated browser origins allowed to call the API. Set this to the
# exact production frontend URL before deployment; do not use *.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Activity details are sent to OpenAI when this is set.
OPENAI_API_KEY=
